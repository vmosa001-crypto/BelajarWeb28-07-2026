# Port server (Railway otomatis set ini)
PORT=5000

# Google Sheets — isi setelah ikuti panduan setup
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google OAuth — buat di console.cloud.google.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=https://your-app.railway.app/auth/google/callback

# Session — string acak yang panjang dan aman
SESSION_SECRET=ganti_dengan_string_rahasia_panjang
